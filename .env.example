# Copy to .env. The deterministic slice needs no credentials at all.

# Planner: "rulebased" (no credentials, narrow phrasings only) or "openai".
LLM_PROVIDER=rulebased

# Required only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set only when pointing at an OpenAI-compatible gateway.
# OPENAI_BASE_URL=

# ClinicalTrials.gov tuning. The API silently caps pageSize at 1000.
CTGOV_PAGE_SIZE=200
CTGOV_MAX_RECORDS=1000
CTGOV_TIMEOUT_SECONDS=30

# Source records attached to each visualization data point.
CITATIONS_PER_POINT=3
